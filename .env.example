# Copy to .env and adjust. Safe to commit (no real secrets).
PORT=3000
# sslmode=disable is required: lib/pq defaults to require, local Postgres has no TLS.
DATABASE_URL=postgres://taskuser:taskpass@localhost:5433/tasks?sslmode=disable
# Secret that signs the JWT access tokens. If unset, the app uses an insecure
# dev default and logs a warning. In production this MUST be set to a long
# random value: anyone who knows it can forge any user's token.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
