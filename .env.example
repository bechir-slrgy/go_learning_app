# Copy to .env and adjust. Safe to commit (no real secrets).
PORT=3000
# sslmode=disable is required: lib/pq defaults to require, local Postgres has no TLS.
DATABASE_URL=postgres://taskuser:taskpass@localhost:5433/tasks?sslmode=disable
# Redis holds refresh tokens (TTL = refresh lifetime). Started by docker compose.
REDIS_ADDR=localhost:6379
# RS256 asymmetric signing. Path to the RSA PRIVATE key that signs access
# tokens; the public key used to verify them is derived from it at startup.
# If unset, the app generates an ephemeral dev key and logs a warning (tokens
# then die on restart). In production this MUST point at a real, secret key:
# anyone who has the private key can forge any user's token.
# Generate one with: openssl genrsa -out keys/jwtRS256.key 2048
# Keep the keys/ directory out of git (see .gitignore).
JWT_PRIVATE_KEY_PATH=keys/jwtRS256.key
