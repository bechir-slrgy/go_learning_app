      "url": "{{ _.base_url }}/api/auth/login",
      "description": "Returns {access_token, refresh_token, ...}. Copy access_token into the environment 'token' variable. Wrong email OR wrong password both return 401.",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
      },
      "headers": [
