      "name": "task_crud_api",
      "description": "CRUD REST API for tasks and users (Go + chi + Postgres, JWT auth). Run an 'auth' > Login request first, copy its access_token into the active environment's 'token' variable, and the protected requests send 'Authorization: Bearer {{ _.token }}'. Seeded users alice@example.com (admin) and bob@example.com (member), password 'password123'.",
      "scope": "collection"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_taskcrud",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8090",
        "token": "",
        "task_id": "PASTE_A_TASK_UUID",
        "user_id": "PASTE_A_USER_UUID",
        "notification_id": "PASTE_A_NOTIFICATION_UUID",
        "webhook_id": "PASTE_A_WEBHOOK_UUID",
        "missing_uuid": "00000000-0000-0000-0000-000000000000"
      },
      "dataPropertyOrder": {
        "&": ["base_url", "token", "task_id", "user_id", "notification_id", "webhook_id", "missing_uuid"]
      },
      "metaSortKey": 1
    },
